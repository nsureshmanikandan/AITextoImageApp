*.mp4
*.mp3
*.wav
*.ogg
*.webm
*.avi
*.mkv
*.flac
*.aac
backend/media/
media/
uploads/
generated/

# ---- Database Files --------------------------------------------------------
*.db
*.sqlite
*.sqlite3
backend/vernacularcast.db

# ---- Environment / Secrets -------------------------------------------------
# NEVER commit real credentials — keep the placeholder .env for demo purposes
# Uncomment the line below to ignore ALL .env variants if you go production:
# .env
.env
.env.local
.env.production
.env.staging
.env.*.local
*.secret
secrets/

# ---- Docker ----------------------------------------------------------------
.docker/
docker-compose.override.yml

# ---- OS Files --------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- IDE / Editor ----------------------------------------------------------
# VS Code — keep extensions.json, ignore personal settings
.vscode/settings.json
.vscode/*.log

# JetBrains
.idea/
*.iml
*.iws

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

